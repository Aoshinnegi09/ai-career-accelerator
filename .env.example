# Copy to .env and fill in values

GEMINI_API_KEY=
DATABASE_URL=sqlite:///./career_accelerator.db
SECRET_KEY=change-me
GROQ_API_KEY=

# ── Registration: open signup by default ─────────────────────────────────────
EMAIL_ALLOWLIST=
EMAIL_ALLOWLIST_ENFORCE_REGISTRATION=false

# ── Email (optional for now) ────────────────────────────────────────────────
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
